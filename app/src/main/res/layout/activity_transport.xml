<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <!-- Scrollable content area (vehicle + VIN + KEY) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnConfirmOnsite">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- VEHICLE PANEL -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/vehiclePanel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivCheckInThumb"
                        android:layout_width="120dp"
                        android:layout_height="90dp"
                        android:layout_marginEnd="12dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/vehicle_thumbnail"
                        android:background="#EEEEEE" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/panelLot"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="LOT #"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="@android:color/black" />

                        <TextView
                            android:id="@+id/panelDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Description"
                            android:textSize="16sp"
                            android:textColor="@android:color/black" />

                        <TextView
                            android:id="@+id/panelVin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="VIN"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@android:color/black" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- VERIFY VIN PANEL (moved here) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/verifyVinPanel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:layout_constraintTop_toBottomOf="@id/vehiclePanel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/verifyVinHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/verifyIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_close_24"
                        app:tint="#D32F2F"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/verifyTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="VERIFY VIN"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@android:color/black"
                        android:gravity="center"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/verifyIcon"
                        app:layout_constraintBottom_toBottomOf="@id/verifyIcon" />

                    <TextView
                        android:id="@+id/verifyVinValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textStyle="bold"
                        android:textSize="28sp"
                        android:textColor="@android:color/black"
                        android:gravity="center"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/verifyTitle" />

                    <LinearLayout
                        android:id="@+id/verifyActions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/verifyVinValue"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVinMatch"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="MATCH"
                            android:backgroundTint="#E8F5E9"
                            android:textColor="#1B5E20"
                            android:textStyle="bold"
                            app:cornerRadius="12dp" />

                        <Space
                            android:layout_width="12dp"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVinNoMatch"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="DOES NOT MATCH"
                            android:backgroundTint="#FFEBEE"
                            android:textColor="#B71C1C"
                            android:textStyle="bold"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/noMatchGroup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/verifyActions"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/enterVinLayout"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="ENTER VIN or 0"
                                app:boxBackgroundMode="outline">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/enterVinInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textCapCharacters"
                                    android:maxLength="17"
                                    android:textColor="@android:color/black"
                                    android:hint="ENTER VIN or 0" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <ImageButton
                                android:id="@+id/btnCamera"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="8dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Open camera"
                                android:scaleType="centerInside"
                                android:padding="8dp"
                                app:tint="@android:color/black"
                                android:src="@android:drawable/ic_menu_camera" />
                        </LinearLayout>

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbVinNotified"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="VIN SPECIALIST HAS BEEN NOTIFIED"
                            android:textColor="@android:color/black"
                            android:layout_marginTop="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVinUpdate"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="UPDATE"
                            android:backgroundTint="#D32F2F"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            android:layout_marginTop="10dp" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KEY CHECK PANEL (moved here, below VIN) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/keyPanel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:layout_constraintTop_toBottomOf="@id/verifyVinPanel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/keyHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/keyIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_close_24"
                        app:tint="#D32F2F"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/keyTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="KEY CHECK"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@android:color/black"
                        android:gravity="center"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/keyIcon"
                        app:layout_constraintBottom_toBottomOf="@id/keyIcon" />

                    <LinearLayout
                        android:id="@+id/keyGroup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/keyIcon"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/keyRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbFobs"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FOB(s)"
                                android:textColor="@android:color/black"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbNoKey"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NO KEY"
                                android:textColor="@android:color/black"
                                android:layout_marginStart="16dp"
                                app:layout_constraintStart_toEndOf="@id/cbFobs"
                                app:layout_constraintTop_toTopOf="@id/cbFobs"
                                app:layout_constraintBottom_toBottomOf="@id/cbFobs"
                                app:layout_constraintEnd_toStartOf="@id/btnKeyCamera" />

                            <ImageButton
                                android:id="@+id/btnKeyCamera"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="12dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Open camera"
                                android:scaleType="centerInside"
                                android:padding="8dp"
                                app:tint="@android:color/black"
                                android:src="@android:drawable/ic_menu_camera"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="@id/cbFobs"
                                app:layout_constraintBottom_toBottomOf="@id/cbFobs" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/enterKeyCountLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:enabled="false"
                            android:alpha="0.6"
                            android:hint="NUMBER OF KEYS"
                            app:boxBackgroundMode="outline">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/enterKeyCountInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:enabled="false"
                                android:hint="NUMBER OF KEYS"
                                android:textColor="@android:color/black" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnKeyUpdate"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="UPDATE"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:backgroundTint="#D32F2F"
                            app:cornerRadius="12dp"
                            android:layout_marginTop="10dp" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- little spacer so last panel doesn't kiss the bottom -->
            <Space
                android:id="@+id/pageBottomSpacer"
                android:layout_width="0dp"
                android:layout_height="24dp"
                app:layout_constraintTop_toBottomOf="@id/keyPanel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky CONFIRM ONSITE button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmOnsite"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="CONFIRM ONSITE"
        android:textAllCaps="true"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="#007bff"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        app:cornerRadius="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>


